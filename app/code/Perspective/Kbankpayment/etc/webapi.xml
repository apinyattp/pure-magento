<?xml version="1.0" encoding="UTF-8"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/direct18/token/" method="POST">
        <service class="Perspective\Kbankpayment\Api\CardInformationInterface" method="getToken"/>
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/V1/direct18/url/:order_id" method="GET">
        <service class="Perspective\Kbankpayment\Api\UrlInformationInterface" method="getUrl"/>
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
     <route method="POST" url="/V1/payment/callback">
        <service class="Perspective\Kbankpayment\Response\cc" method="execute"/>
        <resources>
            <resource ref="anonymous"/>
        </resources>
    </route>
</routes>
